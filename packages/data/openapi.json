  "components": {
    "schemas": {
      "AcceptInvite": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Token"
          },
          "displayName": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Displayname"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token",
          "displayName"
        ],
        "title": "AcceptInvite"
      },
      "Commit": {
        "properties": {
          "ops": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/PutOp"
                },
                {
                  "$ref": "#/components/schemas/RemoveOp"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "put": "#/components/schemas/PutOp",
                  "remove": "#/components/schemas/RemoveOp"
                }
              }
            },
            "type": "array",
            "title": "Ops"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ops"
        ],
        "title": "Commit"
      },
      "CreateFamily": {
        "properties": {
          "family": {
            "$ref": "#/components/schemas/NewFamily"
          },
          "ownerMember": {
            "$ref": "#/components/schemas/OwnerMember"
          },
          "defaults": {
            "$ref": "#/components/schemas/FamilyDefaults"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "family",
          "ownerMember"
        ],
        "title": "CreateFamily"
      },
      "CreatedFamily": {
        "properties": {
          "familyId": {
            "type": "string",
            "title": "Familyid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "familyId"
        ],
        "title": "CreatedFamily"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 8,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "FamilyDefaults": {
        "properties": {
          "categories": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Categories"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "FamilyDefaults"
      },
      "FamilyDoc": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "default": "EUR"
          },
          "defaultSplit": {
            "$ref": "#/components/schemas/SplitSpec"
          },
          "schemaVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Schemaversion",
            "default": 1
          },
          "createdByUserId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Createdbyuserid"
          },
          "createdAtMs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Createdatms"
          },
          "createdByMemberId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Createdbymemberid"
          },
          "updatedAtMs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Updatedatms"
          },
          "updatedByMemberId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Updatedbymemberid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "defaultSplit",
          "createdByUserId",
          "createdAtMs",
          "createdByMemberId",
          "updatedAtMs",
          "updatedByMemberId"
        ],
        "title": "FamilyDoc"
      },
      "FamilySummary": {
        "properties": {
          "family": {
            "$ref": "#/components/schemas/FamilyDoc"
          },
          "memberId": {
            "type": "string",
            "title": "Memberid"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "family",
          "memberId",
          "role"
        ],
        "title": "FamilySummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InviteToken": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "InviteToken"
      },
      "NewFamily": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "default": "EUR"
          },
          "defaultSplit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SplitSpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "schemaVersion": {
            "type": "integer",
