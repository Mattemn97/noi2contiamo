# Copia questo file in .env e adattalo. Nessun valore qui è un segreto vero.

# Frontend: "http" (server Python) oppure "firebase"
VITE_BACKEND=http

# Configurazione pubblica del progetto Firebase (la sicurezza sta nelle regole)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATOR=false

# Server Python
N2C_ENV=development
N2C_DATABASE_URL=sqlite:///./data/noi2contiamo.db
# Obbligatorio con N2C_ENV=production (e con docker compose). Generane uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
N2C_SECRET_KEY=
N2C_STATIC_DIR=apps/web/dist
N2C_HOST=127.0.0.1
N2C_PORT=8000
N2C_COOKIE_SECURE=auto
