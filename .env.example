# Copia questo file in .env e adattalo. Nessun valore qui è un segreto vero.

# Frontend: "http" (server Python) oppure "firebase"
VITE_BACKEND=http

# Configurazione pubblica del progetto Firebase (la sicurezza sta nelle regole)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATOR=false

# Server Python
N2C_ENV=development
N2C_DATABASE_URL=sqlite:///./data/noi2contiamo.db
# Obbligatorio con N2C_ENV=production (e con docker compose). Generane uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
N2C_SECRET_KEY=
N2C_STATIC_DIR=apps/web/dist
N2C_HOST=127.0.0.1
N2C_PORT=8000
N2C_COOKIE_SECURE=auto

# Promemoria per email e Telegram (solo server Python, tutto facoltativo: senza queste variabili il canale resta spento).
# I promemoria in app e le notifiche del browser non richiedono nulla. Con Firebase non c'è invio dal server.
N2C_SMTP_HOST=
N2C_SMTP_PORT=587
N2C_SMTP_USER=
N2C_SMTP_PASSWORD=
N2C_SMTP_FROM=
# starttls (587), ssl (465) oppure none
N2C_SMTP_SECURITY=starttls
# Crea il bot con @BotFather e ricava il chat id scrivendo al bot (o aggiungendolo a un gruppo)
N2C_TELEGRAM_BOT_TOKEN=
N2C_TELEGRAM_CHAT_ID=
# Ogni quanti secondi il server cerca promemoria da inviare, tentativi massimi, età massima per inviarli
N2C_REMINDER_INTERVAL_SECONDS=60
N2C_REMINDER_MAX_ATTEMPTS=5
N2C_REMINDER_MAX_AGE_HOURS=72

# Open banking (Enable Banking), facoltativo: vedi docs/guida-open-banking.md
# N2C_ENABLE_BANKING_APP_ID=
# N2C_ENABLE_BANKING_KEY_FILE=
