{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "rootDir": "src",
    "outDir": "../../node_modules/.tsbuild/web",
    "tsBuildInfoFile": "../../node_modules/.tsbuild/web.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"],
  "references": [{ "path": "../../packages/core" }, { "path": "../../packages/data" }]
}
